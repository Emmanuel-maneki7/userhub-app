generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nickname  String   @unique
  password  String
  nombres   String?
  modo      String?  @default("NORMAL")
  familia   String?  @default("Sin Familia / Ninguno")
  puntos    Int      @default(0) // <-- Nuevo campo para el ranking de puntaje
  tierId    Int?
  tier      Tier?    @relation(fields: [tierId], references: [id], onDelete: SetNull)
  tags      Tag[]
  createdAt DateTime @default(now())
}

model Tier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("#6366f1")
  order     Int      @default(0)
  tabId     Int?
  tab       ModeTab? @relation(fields: [tabId], references: [id], onDelete: Cascade)
  users     User[]
  createdAt DateTime @default(now())
}

model ModeTab {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  tiers     Tier[]
  createdAt DateTime @default(now())
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("#eab308")
  users     User[]
  createdAt DateTime @default(now())
}

model Clan {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}
