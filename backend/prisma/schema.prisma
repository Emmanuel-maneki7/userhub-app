generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nickname  String   @unique
  password  String
  nombres   String?
  modo      String?  @default("Individual / Solo")
  familia   String?
  tierId    Int?
  tier      Tier?    @relation(fields: [tierId], references: [id])
  tags      Tag[]
  createdAt DateTime @default(now())
}

model Tier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("#3b82f6")
  order     Int      @default(0)
  users     User[]
  createdAt DateTime @default(now())
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("#6366f1")
  users     User[]
  createdAt DateTime @default(now())
}
