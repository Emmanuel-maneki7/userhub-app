generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nickname  String   @unique
  password  String
  nombres   String?
  modo      String?  @default("Individual / Solo")
  familia   String?
  tier      String?  @default("Sin Clasificar")
  createdAt DateTime @default(now())
}
